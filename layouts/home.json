{{- /* Virtual filesystem for the interactive prompt: one entry per section and page. */ -}}
{{- /* "weight" follows the top menu, so `ls` lists entries in the same order. */ -}}
{{- $weights := dict -}}
{{- range site.Menus.main -}}
  {{- $w := .Weight -}}
  {{- with .Page -}}{{- $weights = merge $weights (dict .Path $w) -}}{{- end -}}
{{- end -}}
{{- $items := slice -}}
{{- range site.Sections -}}
  {{- $items = $items | append (dict "path" (strings.TrimPrefix "/" .Path) "url" .RelPermalink "title" .Title "dir" true "weight" (index $weights .Path | default 1000)) -}}
{{- end -}}
{{- range site.RegularPages -}}
  {{- $date := "" -}}
  {{- if not .Date.IsZero -}}{{- $date = .Date.Format "2006-01-02" -}}{{- end -}}
  {{- $items = $items | append (dict "path" (printf "%s.md" (strings.TrimPrefix "/" .Path)) "url" .RelPermalink "title" .Title "date" $date "dir" false "weight" (index $weights .Path | default 1000) "order" .Weight) -}}
{{- end -}}
{{- $items | jsonify -}}
